rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'pawell.staciwa@gmail.com';
    }
    match /blog/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'pawell.staciwa@gmail.com';
    }
    match /leads/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'pawell.staciwa@gmail.com';
    }
  }
}